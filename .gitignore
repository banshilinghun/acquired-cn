# ---- 受版权保护的内容,不入库(构建时由管线自行获取/生成) ----
# tools/official/ = acquired.fm 官方文稿（fetch_acquired.py 抓取）
tools/official/
# site/transcripts/ = 其他来源文稿（可选）
site/transcripts/

# ---- 构建产物(build.py 全量重建);zh-index.json 与 site/zh/ 精读全文入库 ----
site/ep/
site/data/*
!site/data/zh-index.json
site/disclaimer/
site/archive/
site/sitemap.xml
site/llms.txt
site/feed.xml

# ---- 运行时状态 ----
tools/audio_sizes.json
tools/zh_model_stats.json
tools/gen_zh_failures.json

# ---- 本地工作区/杂项 ----
work/
*.tsv

# ---- 系统杂项 ----
.DS_Store
__pycache__/
*.pyc
.zcode/
.claude/

# ---- 构建产物：分享卡片 / 特殊页 / 字体与缩略图缓存 ----
site/og/
site/404.html
site/offline.html
tools/.cache/


# ---- 图标由 brand.py icons 在构建时生成 ----
site/*.png
site/favicon.ico
docs/screenshots/
